            <span className="flex items-center gap-1.5">
              <CalendarDays size={16} className="text-slate-400" /> 당일 휴무 현황
            </span>
            <div className="flex items-center gap-3">
              <span>
                🟣 연차: <strong className="text-purple-700">{leaveCount}명</strong>
