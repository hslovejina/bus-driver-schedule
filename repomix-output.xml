      setIsLoading(true);
      try {
        const res = await fetch(`/api/holidays?year=${year}`);
        if (!res.ok) return;
        const data = await res.json();
        if (data && !data.error) setHolidays(data);
      } catch (err) {
        console.error('공휴일 불러오기 실패', err);
      } finally {
        setIsLoading(false);
      }
    };
    fetchHolidays();
  }, [year]);

